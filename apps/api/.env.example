# Local Postgres or Neon's pooled connection string. Never expose to clients.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beside
# Optional direct connection for migrations. On Neon, use its unpooled URL.
DATABASE_URL_UNPOOLED=
PORT=3001
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:8081
# Canonical public API origin, used by the OpenAPI document.
API_PUBLIC_URL=http://localhost:3001
# Random server-only token. Vercel attaches it to cron requests as a bearer token.
CRON_SECRET=
