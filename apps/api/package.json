{
  "name": "@beside/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @beside/domain build && node scripts/copy-swagger-assets.mjs && tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "pnpm --filter @beside/domain build && tsc -p tsconfig.build.json && node scripts/copy-swagger-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:migrate": "node --conditions=source --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "test": "pnpm --filter @beside/domain build && node scripts/copy-swagger-assets.mjs && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@beside/domain": "workspace:*",
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/swagger": "^11.2.6",
    "@vercel/functions": "^3.4.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "^5.32.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@beside/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "26.4.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "7.0.2"
  }
}
