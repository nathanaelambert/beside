# Copy to .env.local. Set a dedicated, spending-limited key privately.
# These variables are server-only. Never add NEXT_PUBLIC_ prefixes.
AI_FILL_ENABLED=false
OPENROUTER_API_KEY=
# Optional; must support high reasoning, tools and structured output.
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Public origin only. Database credentials and API session tokens never go here.
NEXT_PUBLIC_BESIDE_API_URL=http://localhost:3001
