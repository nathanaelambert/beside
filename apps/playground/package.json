{
  "name": "playground",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @beside/domain build && next dev --port 3002",
    "build": "pnpm --filter @beside/domain build && next build",
    "start": "next start --port 3002",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "node --conditions=source --experimental-strip-types --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@beside/rewards": "workspace:*",
    "lucide-react": "1.57.0",
    "mermaid": "12.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.3.6",
    "@beside/domain": "workspace:*",
    "@beside/api-client": "workspace:*"
  },
  "devDependencies": {
    "@beside/eslint-config": "workspace:*",
    "@beside/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
